#!/bin/bash

# ============================================
# Git Pre-commit Hook
# 用途：提交前自动验证学习记录内容
# ============================================

echo "🔍 Running pre-commit validation..."

# 检查是否有修改的HTML文件
CHANGED_HTML=$(git diff --cached --name-only | grep 'records/.*\.html$' || true)

if [ -n "$CHANGED_HTML" ]; then
    echo "📝 检测到学习记录HTML变更："
    echo "$CHANGED_HTML"
    echo ""

    # 运行内容验证脚本
    if [ -f "scripts/validate-content.sh" ]; then
        bash scripts/validate-content.sh
        VALIDATION_RESULT=$?

        if [ $VALIDATION_RESULT -ne 0 ]; then
            echo ""
            echo "❌ 内容验证失败！"
            echo "请修复以下问题后再提交："
            echo "1. 检查HTML内容是否与标题匹配"
            echo "2. 确保词汇卡片完整"
            echo "3. 运行 ./scripts/validate-content.sh 查看详细错误"
            echo ""
            exit 1
        fi
    else
        echo "⚠️  警告：未找到验证脚本 scripts/validate-content.sh"
        echo "建议创建验证脚本以确保内容质量"
    fi
fi

# 检查data.json语法
if git diff --cached --name-only | grep -q 'data.json'; then
    echo "📋 验证 data.json 语法..."
    if command -v python3 &> /dev/null; then
        python3 -m json.tool data.json > /dev/null 2>&1
        if [ $? -ne 0 ]; then
            echo "❌ data.json 语法错误！"
            exit 1
        fi
    fi
fi

echo "✅ Pre-commit validation passed!"
echo ""
exit 0
